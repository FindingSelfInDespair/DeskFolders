<Window x:Class="DeskFolders.Views.FolderPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="416"
        SizeToContent="Height"
        MaxHeight="562"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        Topmost="True"
        AllowDrop="True">
    <Window.Resources>
        <!-- Ультратонкий современный скроллбар -->
        <Style x:Key="ModernScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,4,0,4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsHitTestVisible="True">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbPill"
                                                        Width="5"
                                                        CornerRadius="2.5"
                                                        Background="#48FFFFFF"
                                                        HorizontalAlignment="Center"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbPill" Property="Background" Value="#88FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbPill" Property="Background" Value="#BBFFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsHitTestVisible="True">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0B0B8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F2F2F7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="4,2">
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F21E1E24" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="2,4">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Margin="26,20,26,28"
            Background="#EE1B1B20"
            BorderBrush="#3DFFFFFF"
            BorderThickness="1"
            CornerRadius="24"
            Padding="16,14"
            RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.88" ScaleY="0.88"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.42" Color="Black"/>
        </Border.Effect>

        <Grid x:Name="ContentHost">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <DockPanel Grid.Row="0" Margin="4,0,2,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText"
                               VerticalAlignment="Center"
                               Foreground="#8E8E93"
                               FontSize="12"
                               Margin="0,0,8,0"/>
                                        <Button x:Name="SortBtn"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="Сортировка"
                            Click="OnSortButtonClick"
                            Margin="0,0,2,0">
                        <TextBlock Text="⇅" FontSize="13"/>
                    </Button>
                                        <Button x:Name="PinBtn"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="Закрепить окно папки открытым"
                            Click="OnTogglePinClick"
                            Margin="0,0,2,0">
                        <TextBlock Text="📌" FontSize="11.5"/>
                    </Button>
                    <Button x:Name="EditModeBtn"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="Режим удаления / редактирования"
                            Click="OnToggleEditModeClick"
                            Margin="0,0,2,0">
                        <TextBlock Text="✎" FontSize="13"/>
                    </Button>
                    <Button x:Name="OpenExplorerBtn"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="Открыть папку в проводнике"
                            Click="OnOpenExplorerClick">
                        <TextBlock Text="↗" FontSize="13.5" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>

                <DockPanel VerticalAlignment="Center">
                    <Button x:Name="BackBtn"
                            DockPanel.Dock="Left"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            Visibility="Collapsed"
                            ToolTip="Назад"
                            Click="OnBackClick"
                            Margin="0,0,6,0">
                        <TextBlock Text="‹" FontSize="17" FontWeight="Bold" Margin="0,-2,0,0"/>
                    </Button>
                    <Grid VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText"
                               Foreground="#F5F5F7"
                               FontSize="15.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Cursor="IBeam"
                               ToolTip="Нажмите, чтобы переименовать"
                               TextTrimming="CharacterEllipsis"
                               MouseLeftButtonDown="OnHeaderTextClick"/>
                    <TextBox x:Name="HeaderEditBox"
                             Visibility="Collapsed"
                             FontSize="15"
                             FontWeight="SemiBold"
                             Foreground="#F5F5F7"
                             CaretBrush="#F5F5F7"
                             Background="#26FFFFFF"
                             BorderBrush="#55FFFFFF"
                             BorderThickness="1"
                             Padding="6,2"
                             Margin="-4,0,6,0"
                             KeyDown="OnHeaderEditKeyDown"
                             LostFocus="OnHeaderEditLostFocus"/>
                    </Grid>
                </DockPanel>
            </DockPanel>

            <!-- Живой поиск (появляется при вводе с клавиатуры) -->
            <Border x:Name="SearchBar"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Background="#22FFFFFF"
                    BorderBrush="#2EFFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,5"
                    Margin="2,0,2,10">
                <DockPanel>
                    <TextBlock Text="⌕" Foreground="#98989F" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#F5F5F7"
                             CaretBrush="#F5F5F7"
                             FontSize="12.5"
                             VerticalAlignment="Center"
                             TextChanged="OnSearchTextChanged"/>
                </DockPanel>
            </Border>

            <!-- Сетка элементов + тонкий скролл -->
            <ScrollViewer x:Name="PopupScrollViewer" Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="376">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBarStyle}"/>
                </ScrollViewer.Resources>
                <Grid>
                    <TextBlock x:Name="EmptyText"
                               Text="Папка пуста"
                               Foreground="#8E8E93"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,34"
                               Visibility="Collapsed"/>

                    <ItemsControl x:Name="ItemsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemCard"
                                        Width="78"
                                        MinHeight="{Binding DataContext.ItemCardMinHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                        VerticalAlignment="Top"
                                        Margin="1"
                                        Padding="0,0,0,4"
                                        CornerRadius="14"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        Tag="{Binding}"
                                        ToolTip="{Binding Name}"
                                        PreviewMouseLeftButtonDown="OnItemMouseDown"
                                        PreviewMouseMove="OnItemMouseMove"
                                        PreviewMouseLeftButtonUp="OnItemMouseUp"
                                        MouseEnter="OnItemMouseEnter"
                                        MouseLeave="OnItemMouseLeave">
                                    <Border.ContextMenu>
                                        <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                            <MenuItem Header="Запустить" Style="{StaticResource DarkMenuItemStyle}" Click="OnCtxRunClick"/>
                                            <MenuItem Header="Запустить от имени администратора" Style="{StaticResource DarkMenuItemStyle}" Click="OnCtxRunAdminClick"/>
                                            <MenuItem Header="Переименовать" Style="{StaticResource DarkMenuItemStyle}" Click="OnCtxRenameClick"/>
                                            <MenuItem Header="Открыть расположение файла" Style="{StaticResource DarkMenuItemStyle}" Click="OnCtxOpenLocationClick"/>
                                            <MenuItem Header="Убрать из папки" Style="{StaticResource DarkMenuItemStyle}" Click="OnCtxDeleteClick"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid>
                                        <StackPanel VerticalAlignment="Top"
                                                    HorizontalAlignment="Center"
                                                    Margin="{Binding DataContext.IconStackMargin, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Image x:Name="IconImg"
                                                   Source="{Binding Icon}"
                                                   Width="44"
                                                   Height="44"
                                                   Stretch="Uniform"
                                                   RenderTransformOrigin="0.5,0.5"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Image.RenderTransform>
                                            </Image>
                                            <TextBlock x:Name="ItemLabel"
                                                       Text="{Binding Name}"
                                                       Visibility="{Binding DataContext.ItemLabelVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Margin="0,5,0,0"
                                                       Width="68"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="{Binding DataContext.ItemLabelMaxHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       TextTrimming="{Binding DataContext.ItemLabelTrimming, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Foreground="{Binding DataContext.PrimaryTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="11"
                                                       LineHeight="13"/>
                                        </StackPanel>

                                        <!-- iOS-крестик удаления (виден в режиме редактирования) -->
                                        <Border x:Name="DeleteBadge"
                                                Width="18"
                                                Height="18"
                                                CornerRadius="9"
                                                Background="#EBFF453A"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,3,6,0"
                                                Visibility="{Binding DataContext.EditBadgeVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                                MouseLeftButtonDown="OnDeleteBadgeClick">
                                            <TextBlock Text="×"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

                        <!-- Точки пагинации (режим iOS-страниц) -->
            <StackPanel x:Name="PaginationBar"
                        Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,2"
                        Visibility="Collapsed"/>

            <!-- Нижняя зона корзины при зажатии/перетаскивании (как на iPhone) -->
            <Border x:Name="TrashDropZone"
                    Grid.Row="3"
                    Visibility="Collapsed"
                    Height="42"
                    Margin="4,10,4,0"
                    CornerRadius="12"
                    Background="#28FF453A"
                    BorderBrush="#77FF453A"
                    BorderThickness="1">
                <TextBlock x:Name="TrashZoneLabel"
                           Text="Перетащите сюда, чтобы убрать"
                           Foreground="#FFFF8A80"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Слой-призрак для перетаскиваемой иконки -->
            <Canvas x:Name="DragGhostLayer" Grid.RowSpan="4" IsHitTestVisible="False">
                <Image x:Name="DragGhostImage"
                       Width="48"
                       Height="48"
                       Opacity="0.88"
                       Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Canvas>
        </Grid>
    </Border>
</Window>