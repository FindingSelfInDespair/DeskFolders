<Window x:Class="DeskFolders.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        Topmost="True">
    <Border Margin="16"
            Background="#F41E1E24"
            BorderBrush="#3DFFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.46" Color="Black"/>
        </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TitleLabel" Text="Переименовать" Foreground="#F5F5F7" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBox x:Name="NameBox"
                         Height="32"
                         Padding="8,5"
                         FontSize="13"
                         Foreground="White"
                         CaretBrush="White"
                         Background="#2C2C34"
                         BorderBrush="#4AFFFFFF"
                         BorderThickness="1"
                         KeyDown="OnBoxKeyDown"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Отмена" Width="78" Height="28" Margin="0,0,8,0" Click="OnCancelClick"
                            Background="#2C2C34" Foreground="#E5E5EA" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Сохранить" Width="88" Height="28" Click="OnOkClick"
                            Background="#0A84FF" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
    </Border>
</Window>