<Window x:Class="DeskFolders.Views.LaunchpadBackdropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#A808080D"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        Topmost="True">
    <Window.Resources>
        <Style x:Key="ModernScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,4,0,4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Pill" Width="5" CornerRadius="2.5" Background="#48FFFFFF" HorizontalAlignment="Center"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Pill" Property="Background" Value="#88FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="BackdropGrid">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" Width="460">
            <Border x:Name="SearchPill"
                    Background="#E81E1E24"
                    BorderBrush="#42FFFFFF"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14,9"
                    MouseLeftButtonDown="OnSearchAreaClick">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.42" Color="Black"/>
                </Border.Effect>
                <DockPanel>
                    <TextBlock Text="⌕" Foreground="#98989F" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Grid>
                        <TextBlock x:Name="PlaceholderText"
                                   Text="Поиск приложений во всех папках..."
                                   Foreground="#78FFFFFF"
                                   FontSize="13.5"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 CaretBrush="White"
                                 FontSize="13.5"
                                 VerticalAlignment="Center"
                                 TextChanged="OnSearchTextChanged"/>
                    </Grid>
                </DockPanel>
            </Border>

            <Border x:Name="ResultsBorder"
                    Visibility="Collapsed"
                    Margin="0,8,0,0"
                    Background="#F01C1C22"
                    BorderBrush="#3DFFFFFF"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="10"
                    MaxHeight="340"
                    MouseLeftButtonDown="OnSearchAreaClick">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <ScrollViewer x:Name="ResultsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBarStyle}"/>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <TextBlock x:Name="NoMatchesText"
                                   Text="Ничего не найдено"
                                   Foreground="#8E8E93"
                                   FontSize="12.5"
                                   HorizontalAlignment="Center"
                                   Margin="0,14"
                                   Visibility="Collapsed"/>
                        <ItemsControl x:Name="ResultsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent"
                                            CornerRadius="10"
                                            Padding="8,6"
                                            Cursor="Hand"
                                            Tag="{Binding}"
                                            MouseEnter="OnResultMouseEnter"
                                            MouseLeave="OnResultMouseLeave"
                                            MouseLeftButtonUp="OnResultClick">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding FolderName}"
                                                       Foreground="#8E8E93"
                                                       FontSize="11.5"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,4,0"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}"
                                                       Width="28"
                                                       Height="28"
                                                       Margin="0,0,10,0"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#F5F5F7"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="280"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <TextBlock Text="Режим Launchpad  •  Печатайте для поиска  •  Esc или клик по фону для выхода"
                   Foreground="#66FFFFFF"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,22"/>
    </Grid>
</Window>