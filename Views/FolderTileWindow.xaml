<Window x:Class="DeskFolders.Views.FolderTileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="112"
        Height="128"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        AllowDrop="True">
    <Window.Resources>
        <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F2F2F7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="4,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckMark" Text="✓" Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#5AAFFF" FontSize="11"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Arrow" Grid.Column="2" Text="▸" Visibility="Collapsed" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#98989F"/>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" PopupAnimation="Fade">
                                    <Border Background="#F01E1E24" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="2,4" Margin="2">
                                        <StackPanel IsItemsHost="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F01E1E24" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="2,4">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu Style="{StaticResource DarkContextMenuStyle}" Opened="OnContextMenuOpened">
            <MenuItem Header="Переименовать" Style="{StaticResource DarkMenuItemStyle}" Click="OnRenameClick"/>
            <MenuItem x:Name="ColorSubMenu" Header="Цвет плитки" Style="{StaticResource DarkMenuItemStyle}"/>
            <MenuItem x:Name="CoverSubMenu" Header="Обложка плитки" Style="{StaticResource DarkMenuItemStyle}"/>
            <MenuItem x:Name="SortSubMenu" Header="Сортировка" Style="{StaticResource DarkMenuItemStyle}"/>
            <MenuItem Header="Изменить папку..." Style="{StaticResource DarkMenuItemStyle}" Click="OnChangeFolderClick"/>
            <MenuItem Header="Открыть папку в проводнике" Style="{StaticResource DarkMenuItemStyle}" Click="OnOpenExplorerClick"/>
            <MenuItem Header="Удалить плитку с рабочего стола" Style="{StaticResource DarkMenuItemStyle}" Click="OnRemoveTileClick"/>
        </ContextMenu>
    </Window.ContextMenu>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
        <Border x:Name="TileBorder"
                Margin="0,10,0,0"
                Width="88"
                Height="88"
                CornerRadius="20"
                BorderThickness="1"
                Padding="10"
                Cursor="Hand"
                RenderTransformOrigin="0.5,0.5"
                MouseEnter="OnTileMouseEnter"
                MouseLeave="OnTileMouseLeave">
            <Border.RenderTransform>
                <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="9" ShadowDepth="2" Opacity="0.28" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Border x:Name="HoverOverlay"
                        Margin="-10"
                        CornerRadius="20"
                        Background="#1CFFFFFF"
                        Opacity="0"
                        IsHitTestVisible="False"/>
                <UniformGrid x:Name="PreviewGrid" Rows="2" Columns="2"/>
                <Image x:Name="CustomCoverImage"
                       Visibility="Collapsed"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border x:Name="MissingBadge"
                        Visibility="Collapsed"
                        Width="26" Height="26"
                        CornerRadius="13"
                        Background="#E0FF9F0A"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="TitleText"
                   Width="104"
                   Margin="0,5,0,0"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="White"
                   FontSize="12"
                   FontWeight="Medium">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.85" Color="Black"/>
            </TextBlock.Effect>
        </TextBlock>
    </StackPanel>
</Window>